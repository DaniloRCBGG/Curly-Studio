# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Pix do sinal. Três jeitos, escolhidos pelo que estiver preenchido:
# 1. ASAAS_API_KEY preenchida: cobrança no Asaas, confirmada sozinha.
# 2. Só PIX_CHAVE preenchida: Pix direto na chave da Carol; a cliente toca em "Já paguei",
#    manda o comprovante no WhatsApp e a equipe aperta "Confirmar sinal" no painel.
# 3. Nenhuma das duas: modo de teste, com Pix simulado.
# Chave como está cadastrada no banco: e-mail, CPF só números, celular no formato +5521999999999 ou chave aleatória.
PIX_CHAVE=
# Nome e cidade que aparecem no app do banco de quem paga (sem acento, até 25 e 15 letras)
PIX_NOME=Carol Rios
PIX_CIDADE=Rio de Janeiro

# Asaas (conta no nome da Carol), opcional.
ASAAS_API_KEY=
# Sandbox: https://api-sandbox.asaas.com/v3 · Produção: https://api.asaas.com/v3
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Token escolhido por vocês e cadastrado também no webhook do painel do Asaas
ASAAS_WEBHOOK_TOKEN=

# Protege a rota de limpeza diária. Escolha um texto longo e aleatório; a tarefa agendada
# da Netlify (netlify/functions/expirar-reservas.mts) envia esse mesmo valor.
CRON_SECRET=
