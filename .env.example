# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Asaas (conta no nome da Carol). Sem ASAAS_API_KEY o site roda em modo de teste, com Pix simulado.
ASAAS_API_KEY=
# Sandbox: https://api-sandbox.asaas.com/v3 · Produção: https://api.asaas.com/v3
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Token escolhido por vocês e cadastrado também no webhook do painel do Asaas
ASAAS_WEBHOOK_TOKEN=

# Protege a rota de limpeza diária (a Vercel envia automaticamente)
CRON_SECRET=
